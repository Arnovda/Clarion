# Local UI development (Windows, no Docker needed).
#
# Copy this file to `.env.local` and run `npm run dev` in this folder. The Next
# dev server runs on http://localhost:3000 with hot reload, talking to a
# DEPLOYED backend (real API, real data) — so you can see UI changes instantly
# without running any database/backend locally.
#
# Point this at your production (or a staging-revision) backend's /api URL:
NEXT_PUBLIC_API_URL=https://<your-backend-host>/api

# One-time backend requirement: the backend's CORS_ORIGIN must include
# http://localhost:3000 so the browser is allowed to call it from localhost.
# (Add it to the backend Container App's CORS_ORIGIN env var, comma-separated.)
