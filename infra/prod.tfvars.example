# Copy this file to prod.tfvars and fill in your values.
# NEVER commit prod.tfvars — it contains secrets.

project_name = "databridge"
environment  = "prod"
location     = "westeurope"    # Netherlands — closest to Belgium

# PostgreSQL (~25 EUR/month — the only always-on cost)
pg_admin_user     = "databridge"
pg_admin_password = "CHANGE_ME_strong_password_here"
pg_sku            = "B_Standard_B1ms"

# Secrets (generate with: openssl rand -hex 32)
jwt_secret                 = "CHANGE_ME_random_64_char_string"
anthropic_api_key          = "sk-ant-..."
credentials_encryption_key = "CHANGE_ME_random_32_char_string"
neo4j_password             = "CHANGE_ME_strong_password_here"

# Leave empty on first deploy — update after you see the Container App URLs
frontend_url = ""

# Your local IP (for running migrations). Find at: https://whatismyipaddress.com
local_ip = ""

# Custom domain (leave empty to use Azure auto-generated URLs)
custom_domain = ""

tags = {
  project    = "databridge"
  managed_by = "terraform"
  owner      = "arno"
}
