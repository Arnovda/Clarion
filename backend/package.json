{
  "name": "databridge-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "migrate:latest": "node -r ts-node/register ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "node -r ts-node/register ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:rollback",
    "migrate:status": "node -r ts-node/register ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:status",
    "seed": "ts-node src/seed.ts",
    "seed:hr": "ts-node src/seed-hr.ts",
    "seed:postgres": "ts-node src/seed-postgres.ts",
    "neo4j:migrate": "ts-node src/db/migrateSemanticToNeo4j.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:shared-trx-catch": "tsx scripts/lint-shared-trx-catch.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@azure/arm-appcontainers": "^3.0.0",
    "@azure/communication-email": "^1.0.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.10.0",
    "@azure/storage-blob": "^12.31.0",
    "@databridge/connectors": "file:../packages/connectors",
    "@simplewebauthn/server": "^13.3.0",
    "@types/nodemailer": "^8.0.0",
    "applicationinsights": "^3.14.0",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "latest",
    "bullmq": "^5.73.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.4.5",
    "duckdb-async": "^1.4.2",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mssql": "^12.2.1",
    "mysql2": "^3.20.0",
    "neo4j-driver": "^5.27.0",
    "nodemailer": "^8.0.5",
    "otplib": "^12.0.1",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^9.1.11",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
