# Environment
.env

# Dependencies
node_modules/

# Build output
dist/
.next/

# SQLite source data (generated by seed script)
data/

# Delta Lake warehouse (generated by ETL ingestion)
# Anchored to top-level + backend/ so it doesn't catch
# backend/src/services/warehouse/ source code (which is what the
# /warehouse/ rule is *not* trying to match).
/warehouse/
/backend/warehouse/

# Terraform (infra/ has its own .gitignore but just in case)
*.tfstate
*.tfstate.backup
.terraform/

# Claude Code internal files
.claude/

# Logs
*.log

# Terraform plans (binary, regenerable)
*.tfplan

# Python
__pycache__/
*.pyc
.pytest_cache/

# OS
.DS_Store
Thumbs.db
dump.rdb
