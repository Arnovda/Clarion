# Backend
PORT=3001
NODE_ENV=development

# Semantic layer DB — PostgreSQL running in Docker
# This is the platform's own internal database (definitions, logs, gaps)
DATABASE_URL=postgresql://databridge:databridge@localhost:5432/databridge

# JWT auth
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h

# Claude API (get key from console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6
# Cheaper model used for summarisation-class calls (formatAnswer, validator).
# ~12× cheaper than Sonnet. See docs/rfc-001-activation-guide.md + Stage A plan.
CLAUDE_MODEL_HAIKU=claude-haiku-4-5-20251001

# SQLite source database — path to the client's .db file on this machine
# For POC, point this to data/sample.db which is generated by the seed script
SQLITE_DB_PATH=./data/sample.db

# Neo4j — semantic knowledge graph (runs in Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=databridge_secret
NEO4J_DATABASE=neo4j

# Encryption key for connection credentials at rest (AES-256-GCM)
# In production, set this to a strong random string (e.g. 32+ chars)
# If not set, credentials are stored in plain text (dev mode only)
CREDENTIALS_ENCRYPTION_KEY=

# ETL service — Python FastAPI container for Delta Lake ingestion
ETL_URL=http://localhost:8000

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Redis (for job queues + caching — Block 2.1)
REDIS_URL=

# ─── SMTP — Scheduled email reports ──────────────────────────────────────────
# Leave SMTP_HOST blank to disable email sending (reports are no-ops in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Clarion <noreply@yourdomain.com>

# ─── Transformations ──────────────────────────────────────────────────────────

# Route product transformations through dbt-duckdb instead of the in-house
# transformationRunner.ts. Phase 1 of the dbt migration (see
# docs/rfc-001-dbt-transformations.md). Default: false (legacy runner).
# When true, the ETL image must be rebuilt with dbt-duckdb + dbt-core pinned
# in etl/requirements.txt (already added).
USE_DBT_TRANSFORMATIONS=false

# Cron for the weekly Delta OPTIMIZE + VACUUM job. Default: Sunday 03:00.
# Server's local timezone. Runs regardless of USE_DBT_TRANSFORMATIONS.
WAREHOUSE_MAINTENANCE_CRON=0 3 * * 0

# Warehouse layout version for product tables. v2 = tenant-prefixed, id-stable
# layout `<root>/tenant_<tid>/product_<pid>/<table>` (matches the source-side
# layout from SyncOrchestrator and eliminates cross-tenant collisions in the
# product layer). v1 = legacy `./warehouse/product/<slug>` layout. Mixed-state
# is fine: existing rows keep their old delta_path until re-refreshed; new
# writes from v2 builds go to the new layout. Default: v1.
WAREHOUSE_LAYOUT_VERSION=v1

# Azure Blob container for the warehouse. Used in Azure mode (when
# AZURE_CONTAINER_APPS_JOB_NAME is set). Default: 'warehouse'.
AZURE_WAREHOUSE_CONTAINER=warehouse

# ─── Azure (production only — leave blank for local development) ───────────

# Azure Blob Storage — replaces local warehouse/ directory
AZURE_STORAGE_CONNECTION_STRING=

# Azure Key Vault — secrets management (overrides env vars when set)
AZURE_KEY_VAULT_URL=

# Azure Application Insights — monitoring and telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=
