# Backend
PORT=3001
NODE_ENV=development

# Semantic layer DB — PostgreSQL running in Docker
# This is the platform's own internal database (definitions, logs, gaps)
DATABASE_URL=postgresql://databridge:databridge@localhost:5432/databridge

# JWT auth
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h

# Claude API (get key from console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6
# Cheaper model used for summarisation-class calls (formatAnswer, validator).
# ~12× cheaper than Sonnet. See docs/rfc-001-activation-guide.md + Stage A plan.
CLAUDE_MODEL_HAIKU=claude-haiku-4-5-20251001

# Anthropic structured outputs (constrained decoding) for dashboard-spec
# calls. When =1, generate/refine/validate dashboard calls send the spec's
# JSON Schema as `output_format` + the structured-outputs beta header, so
# the API guarantees well-formed schema-valid JSON (no truncation/format
# failures). Default OFF. There is no staging environment — before enabling,
# run the one-shot live check (needs only the API key, touches no data):
#   cd backend && npx tsx scripts/verify-structured-outputs.ts
# PASS -> set =1 here. FAIL -> leave unset (behaviour unchanged) and see the
# printed error (the pinned SDK predates the feature; params passed via cast).
AI_STRUCTURED_OUTPUTS=

# SQLite source database — path to the client's .db file on this machine
# For POC, point this to data/sample.db which is generated by the seed script
SQLITE_DB_PATH=./data/sample.db

# Neo4j — semantic knowledge graph (runs in Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=databridge_secret
NEO4J_DATABASE=neo4j

# Encryption key for connection credentials at rest (AES-256-GCM)
# In production, set this to a strong random string (e.g. 32+ chars)
# If not set, credentials are stored in plain text (dev mode only)
CREDENTIALS_ENCRYPTION_KEY=

# Auto-profile after every successful sync.
#
# Default: false. Routine refresh pipelines (sync of unchanged schema) run
# entirely without AI cost. When the introspected schema differs from the
# stored one, an admin notification is emitted: "Schema changed —
# re-profile recommended". The user clicks Re-profile manually to spend
# the AI tokens on regenerating descriptions.
#
# Set to 'true' to opt back into the legacy auto-profile-after-sync
# behaviour: any drift is auto-resolved by spending ~$0.85 of Claude
# tokens per source per sync (Sonnet for table_context + multiple batches
# of column_descriptions). Recommended only for setups where (a) sources
# change structure unpredictably and (b) you've budgeted for the cost.
AUTO_REPROFILE_ON_SYNC=false

# ETL service — Python FastAPI container for Delta Lake ingestion
ETL_URL=http://localhost:8000

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Redis (for job queues + caching — Block 2.1)
REDIS_URL=

# ─── Email — password resets, scheduled reports ──────────────────────────────
# Two providers supported. First one configured wins. With NO provider
# configured, the forgot-password flow accepts requests but no email ever
# arrives, leaving users locked out — configure at least one in any deployed
# environment.

# Preferred: Azure Communication Services Email. Provisioned automatically
# by Terraform (infra/main.tf), wired to the backend Container App's
# Managed Identity — no API keys to manage. These env vars are set by
# Terraform; locally they're empty (local dev falls back to the SMTP or
# no-op path below).
#
# In Azure Container App: ACS_ENDPOINT is the only required var. The
# Managed Identity authenticates via DefaultAzureCredential.
# Locally for dev: set ACS_CONNECTION_STRING instead (one-line escape
# hatch when MSI isn't reachable — same Key Vault security model as
# DATABASE_URL).
ACS_ENDPOINT=
ACS_CONNECTION_STRING=
# Sender address — derived from the Azure-managed email domain. Looks
# like donotreply@<random>.azurecomm.net. Terraform writes this for
# you; for local dev you can leave it blank and the no-op path catches.
ACS_SENDER_ADDRESS=

# Legacy fallback: SMTP via nodemailer. Used only if no ACS vars are
# set AND SMTP_HOST is. Kept for operators who want to route through
# a corporate Exchange / Postfix / Mailgun-SMTP-relay. Note: Azure
# Container Apps blocks port 25 outbound and 587/465 routing is
# environment-specific — ACS is the more reliable path on Azure.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Clarion <noreply@yourdomain.com>

# ─── Transformations ──────────────────────────────────────────────────────────

# Route product transformations through dbt-duckdb instead of the in-house
# transformationRunner.ts. Phase 1 of the dbt migration (see
# docs/rfc-001-dbt-transformations.md). Default: false (legacy runner).
# When true, the ETL image must be rebuilt with dbt-duckdb + dbt-core pinned
# in etl/requirements.txt (already added).
USE_DBT_TRANSFORMATIONS=false

# Cron for the weekly Delta OPTIMIZE + VACUUM job. Default: Sunday 03:00.
# Server's local timezone. Runs regardless of USE_DBT_TRANSFORMATIONS.
WAREHOUSE_MAINTENANCE_CRON=0 3 * * 0

# Warehouse layout version for product tables. v2 = tenant-prefixed, id-stable
# layout `<root>/tenant_<tid>/product_<pid>/<table>` (matches the source-side
# layout from SyncOrchestrator and eliminates cross-tenant collisions in the
# product layer). v1 = legacy `./warehouse/product/<slug>` layout. Mixed-state
# is fine: existing rows keep their old delta_path until re-refreshed; new
# writes from v2 builds go to the new layout. Default: v1.
WAREHOUSE_LAYOUT_VERSION=v1

# Azure Blob container for the warehouse. Used in Azure mode (when
# AZURE_CONTAINER_APPS_JOB_NAME is set). In shared-container mode this single
# container holds every tenant's data. Default: 'warehouse'.
AZURE_WAREHOUSE_CONTAINER=warehouse

# Warehouse tenant-isolation mode.
#   shared     (default) — one Blob container, tenants separated by a
#                          `tenant_<id>/` path prefix (code-enforced isolation).
#   per-tenant           — each tenant gets its OWN Blob container
#                          (`<prefix><tenantId>`). Isolation becomes a hard
#                          storage boundary: a worker SAS scoped to one tenant's
#                          container cannot touch another's, and offboarding a
#                          tenant is a single container delete.
# Behaviour-preserving default (shared). Flipping to per-tenant only affects
# NEW writes; existing data keeps reading from its stored absolute URI.
# REQUIRES: the backend's identity/connection string can create Blob containers
# (Storage Blob Data Contributor or account key). Validate in staging first.
WAREHOUSE_CONTAINER_MODE=shared
# Container name prefix in per-tenant mode (container = <prefix><tenantId>,
# e.g. 'tenant-42'). Must yield a valid Azure container name. Default 'tenant-'.
AZURE_WAREHOUSE_CONTAINER_PREFIX=tenant-

# ── DuckDB compute guardrails (default ON) ──────────────────────────────────
# Bound DuckDB's memory + threads so a heavy AI-generated query on a small
# (e.g. 1 GB) replica can't OOM-kill the process. A query exceeding the memory
# budget SPILLS to DUCKDB_TEMP_DIR instead of failing.
DUCKDB_MEMORY_LIMIT=70%
DUCKDB_THREADS=2
# DUCKDB_TEMP_DIR=            # default: OS temp dir. Set '' to disable spilling.
# Max rows a single query may materialise into Node memory (protects the JS
# heap from a runaway cross-join). Set 0 to disable. Default 100000.
DUCKDB_MAX_RESULT_ROWS=100000
# Concurrency + timeout controls for the shared in-process DuckDB query engine.
# Global cap = total in-flight analytical queries per replica (blast-radius /
# OOM protection); per-tenant cap = fairness so one tenant can't take every
# permit. Query timeout frees the caller from a runaway query (it does not
# interrupt the underlying DuckDB call). Pool max = live pooled DuckDB
# instances before LRU eviction.
DUCKDB_MAX_CONCURRENT_QUERIES=6
DUCKDB_MAX_CONCURRENT_QUERIES_PER_TENANT=2
DUCKDB_QUERY_TIMEOUT_MS=45000
DUCKDB_POOL_MAX=12
# OPT-IN defence-in-depth (default OFF). Blocks DuckDB's local filesystem on
# Azure-mode read sessions, so query SQL can't touch container disk even if it
# got past the SQL guard. NOT enabled by default because it very likely breaks
# spill-to-disk (DUCKDB_TEMP_DIR) on large scans — validate against a real
# warehouse first. Note `enable_external_access=false` is deliberately NOT used:
# it would disable the az:// reads the platform depends on.
# DUCKDB_SESSION_LOCKDOWN=1
# DUCKDB_LOCK_CONFIGURATION=1   # also freeze session config (needs the above)

# Child-process query runner (default OFF — set to 'child' to enable).
# Runs each warehouse query in its own OS process so DUCKDB_QUERY_TIMEOUT_MS can
# actually KILL it: in-process the timeout only frees the caller while the query
# keeps burning CPU and holding its concurrency permit. Also contains a DuckDB
# OOM or native crash to one runner instead of taking the API down for every
# tenant. Warm runners are pooled per (warehouse × table-set), so the ~500ms view
# registration is paid once, not per query. Falls back to in-process
# automatically if the compiled runner script isn't present (TS dev mode).
# In production this is driven by the GitOps control .ops/duckdb-runner, not by
# Terraform — see .ops/README.md. Look for the one-time log line
# "Child-process query runner ACTIVE" to confirm it is really in use.
# DUCKDB_RUNNER=child
# Max warm runner processes. DUCKDB_MEMORY_LIMIT and DUCKDB_THREADS above are
# DIVIDED across these slots (e.g. 70% / 4 = 17% each), so all runners together
# stay inside the budget a single in-process session had. Raising this makes each
# runner smaller; it does not raise the replica's total footprint.
DUCKDB_RUNNER_MAX=4
DUCKDB_RUNNER_IDLE_MS=600000     # evict a runner after 10 min idle
DUCKDB_RUNNER_INIT_TIMEOUT_MS=60000

# Postgres connection pool (per backend/worker process). The sum across all
# replicas must stay under Postgres max_connections (~50 on B1ms). A saturated
# pool fails fast after acquire-timeout instead of hanging the request.
KNEX_POOL_MAX=10
KNEX_POOL_MIN=2
KNEX_POOL_ACQUIRE_TIMEOUT_MS=30000

# Directory SQLite source files must live under (sandbox). A connection whose
# filepath resolves outside this dir is refused. Default: the repo data/ dir.
# SQLITE_SOURCE_DIR=/sources

# Data-retention windows (days). A daily sweep prunes rows older than the
# window. 0 = keep forever. Operational logs default to a bounded window;
# user CONTENT (query history, conversation messages) defaults to 0 (off) —
# retaining a customer's own data is a policy decision, set it explicitly.
RETENTION_NOTIFICATION_DAYS=90
RETENTION_AI_CALL_LOG_DAYS=365
RETENTION_QUERY_LOG_DAYS=0
RETENTION_CONVERSATION_DAYS=0

# Storage format for product tables. Delta Lake + Python sidecar is the
# DEFAULT — every refresh writes Delta files and persists per-refresh
# row-hash change counts (unchanged/updated/inserted/deleted) to
# `product_table_refresh_history`. The chart on /products/[id] reads
# from there. Foundation for SCD2 — see docs/backlog/SCD2.md.
#
# Set `STORAGE_FORMAT=parquet` to opt out (useful for local dev where
# Python + deltalake/pandas/pyarrow aren't installed). Production
# images bake them in, so leaving this unset is correct in Azure.
STORAGE_FORMAT=

# Path to the Python interpreter the SCD1/SCD2 sidecar runs under.
# Defaults to `python3` on PATH; override when the deployment ships
# Python at a non-default location (e.g. `/usr/bin/python3.12`).
PYTHON_BIN=

# Override for the sidecar script location. Defaults to
# `<repo>/etl/scd2/commit_table.py`. Useful when the backend container
# bundles the script at a different path.
SCD2_SIDECAR_PATH=

# Connector star-schema templates (docs/SOURCE_ONBOARDING.md Phase F).
# When a connector ships a deterministic fact/dim template (Odoo today),
# "Prepare my data" instantiates it instead of running the AI designer —
# instant, token-free, identical across customers. Set to 1 to force the
# AI designer for every connector (escape hatch; default: templates on).
STAR_SCHEMA_TEMPLATES_DISABLED=

# ─── Azure (production only — leave blank for local development) ───────────

# Azure Blob Storage — replaces local warehouse/ directory
AZURE_STORAGE_CONNECTION_STRING=

# Azure Key Vault — secrets management (overrides env vars when set)
AZURE_KEY_VAULT_URL=

# Azure OpenAI Service — per-category model overrides
# Deploy GPT-4o, GPT-4o-mini, etc. in your Azure OpenAI resource, then
# point the backend at it. The admin UI lets you pick which model to use
# for each AI call category (NL→SQL, dashboards, formatting, etc.).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Comma-separated list of deployment names available in your Azure OpenAI
# resource. If empty, the UI shows a default list (gpt-4o, gpt-4o-mini, etc.)
AZURE_OPENAI_DEPLOYMENTS=

# Azure AI Foundry — serverless model deployments (Llama, Phi, etc.)
# Single endpoint per model deployment.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=

# Azure Application Insights — monitoring and telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Foreign-key verification (schema profiler). A relationship is accepted only
# when the target is near-unique in its own table (i.e. actually a key), the
# source has enough distinct values that agreement is not coincidence, and the
# source's values are a near-subset of the target's. Raw value OVERLAP is not
# used: a line counter with 40 values that all exist in some code table scores
# 100% at any sample size.
FK_SAMPLE_SIZE=1000            # distinct source values sampled per candidate
FK_MIN_DISTINCT=8              # below this, agreement is not evidence
FK_TARGET_UNIQUENESS=0.99      # distinct/rows on the target — measured, not guessed from the column name
FK_MIN_CONTAINMENT=0.85        # share of sampled source values found in the target
FK_VERIFY_BUDGET_MS=180000     # wall-clock cap on verifying Pass B's relationships;
                               # candidates past it are kept as unchecked drafts and reported

# Relationship canvas — how long a single "does this relationship hold?" check
# may take before it answers "we couldn't tell you quickly". Deliberately far
# below DUCKDB_QUERY_TIMEOUT_MS: this runs while a popover is open under the
# user's cursor, and a spinner is worse than an honest shrug.
RELATIONSHIP_MEASURE_TIMEOUT_MS=8000
