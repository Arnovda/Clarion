# Backend
PORT=3001
NODE_ENV=development

# Semantic layer DB — PostgreSQL running in Docker
# This is the platform's own internal database (definitions, logs, gaps)
DATABASE_URL=postgresql://databridge:databridge@localhost:5432/databridge

# JWT auth
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h

# Claude API (get key from console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# SQLite source database — path to the client's .db file on this machine
# For POC, point this to data/sample.db which is generated by the seed script
SQLITE_DB_PATH=./data/sample.db

# Neo4j — semantic knowledge graph (runs in Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=databridge_secret
NEO4J_DATABASE=neo4j

# Encryption key for connection credentials at rest (AES-256-GCM)
# In production, set this to a strong random string (e.g. 32+ chars)
# If not set, credentials are stored in plain text (dev mode only)
CREDENTIALS_ENCRYPTION_KEY=

# ETL service — Python FastAPI container for Delta Lake ingestion
ETL_URL=http://localhost:8000
